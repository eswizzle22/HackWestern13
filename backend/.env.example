# Local TimescaleDB from docker-compose.yml. For Tiger Cloud, paste its connection string here instead
# (it ends in ?sslmode=require).
DATABASE_URL=postgres://postgres:prodrome@localhost:5432/prodrome
PORT=3000
# Origin of the frontend, allowed to call this API from the browser.
FRONTEND_ORIGIN=http://localhost:8000
# Shared secret the sensor script sends in the x-device-key header. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_KEY=
# A device silent for this long is shown as offline.
OFFLINE_AFTER_SECONDS=120
# A running session asks "still working?" this many minutes after it started (or was last confirmed),
# and ends by itself if there is no answer within the grace period. Use small values to try it quickly.
CHECKIN_MINUTES=60
CHECKIN_GRACE_MINUTES=5
