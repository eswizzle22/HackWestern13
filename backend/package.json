{
  "name": "prodrome-backend",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env db/migrate.js",
    "db:reset": "node --env-file-if-exists=.env db/reset.js",
    "simulate": "node --env-file-if-exists=.env scripts/simulate-device.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/",
    "seed": "node --env-file-if-exists=.env db/seed.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
